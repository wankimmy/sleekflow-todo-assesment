# Default .env targets Docker Compose service DNS names (used by the app container).
DATABASE_URL="postgresql://sleekflow:sleekflow@postgres:5432/sleekflow_todo?schema=public"
TEST_DATABASE_URL="postgresql://sleekflow:sleekflow@postgres-test:5432/sleekflow_todo_test?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# For host-side Next/Prisma/Vitest, copy to .env.local and use published ports:
